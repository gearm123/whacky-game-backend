PORT=3001

# Postgres connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional alternatives:
# POSTGRES_URL=
# DATABASE_URL_FILE=

# Optional admin auth for /admin/users and /admin/refill-requests.
# Leave blank only for local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session lifetime for simple username/password sign-in.
AUTH_SESSION_DAYS=30
