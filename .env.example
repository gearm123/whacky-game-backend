PORT=3001

# Postgres connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional alternatives:
# POSTGRES_URL=
# DATABASE_URL_FILE=

# Optional admin auth for /admin/deposits.
# Leave blank only for local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session lifetime for simple username/password sign-in.
AUTH_SESSION_DAYS=30

# TrueMoney deposit instructions shown to signed-in users.
TRUEMONEY_RECIPIENT_NAME=Your TrueMoney receiving account
TRUEMONEY_RECIPIENT_ACCOUNT=TO_BE_CONFIGURED
TRUEMONEY_RECIPIENT_NOTE=Replace this with the real receiving wallet/account details later.
